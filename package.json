{
  "name": "gta-quilmes",
  "version": "0.1.0",
  "description": "GTA-style 3D open world of Quilmes, Buenos Aires, built from OpenStreetMap data",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "fetch-osm": "node scripts/fetch-osm.mjs",
    "fetch-overture": "python3 scripts/fetch_overture.py --radius 2500 && node scripts/fetch-osm.mjs --input .cache/overture-raw.json --radius 2500",
    "fetch-buses": "python3 scripts/fetch_buses.py",
    "fetch-shops": "node scripts/fetch-shops.mjs",
    "import-places": "node scripts/import-places.mjs",
    "check": "node scripts/check-geo.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezebonasegla/GTA-ARG.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ezebonasegla/GTA-ARG/issues"
  },
  "homepage": "https://github.com/ezebonasegla/GTA-ARG#readme",
  "dependencies": {
    "3d-tiles-renderer": "^0.5.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "vite": "^8.3.1"
  },
  "type": "module",
  "private": true
}
